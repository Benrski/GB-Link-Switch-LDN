CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PICO_LINK_TX_GPIO=2
CONFIG_PICO_LINK_RX_GPIO=1
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=y
CONFIG_FREERTOS_HZ=1000
# 1.5 MB app partition; the key NVS partition stays at its default location.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Bridge runs on the main task; hosting a room adds Wi-Fi AP start-up to its stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
