CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# GPIO2, 8 and 9 are C3 strapping pins.
CONFIG_PICO_LINK_TX_GPIO=5
CONFIG_PICO_LINK_RX_GPIO=4
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=y
CONFIG_FREERTOS_HZ=1000
# 1.5 MB app partition; the key NVS partition stays at its default location.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Bridge runs on the main task; hosting a room adds Wi-Fi AP start-up to its stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# The C3 has the least RAM of the four chips, and its code RAM and data RAM are the same
# memory: Wi-Fi's receive and hot-path code runs from flash instead, the Wi-Fi buffers are
# trimmed as on the original ESP32 (Switch networks are 802.11b/g, no aggregation), and the
# USB console buffers are cut to 8 KB and 4 KB (the original ESP32's UART ones are 4 KB).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_LWIP_IPV6=n
CONFIG_BRIDGE_USB_RX_BUFFER=8192
CONFIG_BRIDGE_USB_TX_BUFFER=4096
# 8.5 dBm: some C3 boards garble their frames at full power and never get a join answered.
CONFIG_BRIDGE_WIFI_MAX_TX_POWER=34
