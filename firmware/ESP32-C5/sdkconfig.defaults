CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# XIAO D1/D0, as on the XIAO S3; GPIO2, 3, 7 and 25-28 are C5 strapping pins.
CONFIG_PICO_LINK_TX_GPIO=0
CONFIG_PICO_LINK_RX_GPIO=1
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=y
CONFIG_FREERTOS_HZ=1000
# 1.5 MB app partition; the key NVS partition stays at its default location.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Bridge runs on the main task; hosting a room adds Wi-Fi AP start-up to its stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# As on the C3: code and data share little static RAM, the Wi-Fi buffers are trimmed
# (802.11b/g, no aggregation) and the USB console buffers cut to 8 KB and 4 KB. Wi-Fi's
# hot path stays in IRAM, as flash shares the cache with PSRAM; sleep and PHY code goes
# to flash, as power save is off.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_LWIP_IPV6=n
CONFIG_BRIDGE_USB_RX_BUFFER=8192
CONFIG_BRIDGE_USB_TX_BUFFER=4096
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_PM_SLP_IRAM_OPT=n
CONFIG_PM_SLEEP_FUNC_IN_IRAM=n
# The XIAO's 8 MB PSRAM takes large allocations, the Wi-Fi and lwIP buffers and the zstd
# context; a C5 without it still boots. Its 1.8 s boot test is skipped.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_PIA_STATIC_ZSTD_CONTEXT=n
