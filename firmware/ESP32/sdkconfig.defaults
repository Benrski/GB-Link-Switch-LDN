CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
# No native USB: console is UART0 (GPIO1/3) behind the board's USB bridge, at 921600
# from boot. A browser cannot change the rate of an open port, and adapter traffic
# needs more than 115200. "Custom" is required in ESP-IDF to set the rate.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PICO_LINK_TX_GPIO=17
CONFIG_PICO_LINK_RX_GPIO=16
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=y
CONFIG_FREERTOS_HZ=1000
# 1.5 MB app partition; the key NVS partition stays at its default location.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Static data is limited to ~124 KB on this chip; the zstd context is heap-allocated at boot.
CONFIG_PIA_STATIC_ZSTD_CONTEXT=n
# Bridge runs on the main task; hosting a room adds Wi-Fi AP start-up to its stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Heap for the access point when the GBA leads. Switch networks are 802.11b/g (no
# aggregation). Four static RX buffers, dynamic ones capped for bursts. No IPv6.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_LWIP_IPV6=n
